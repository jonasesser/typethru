{
  "manifest_version": 3,
  "name": "TypeThru – Paste text into the vSphere web console",
  "short_name": "TypeThru",
  "version": "0.5.0",
  "description": "Types text such as passwords, commands or license keys into the vSphere HTML5 web console, where copy and paste is not available.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TypeThru",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open the TypeThru popup"
    }
  }
}
